{
  "private": true,
  "keywords": [
    "esm",
    "react",
    "server",
    "ssr"
  ],
  "bugs": {
    "url": "https://github.com/lazarv/react-server/issues"
  },
  "license": "MIT",
  "author": "lazarv",
  "repository": {
    "type": "git",
    "url": "https://github.com/lazarv/react-server.git"
  },
  "type": "module",
  "scripts": {
    "test": "pnpm --filter ./test test",
    "format": "oxfmt . --no-error-on-unmatched-pattern",
    "lint": "oxlint",
    "docs": "pnpm --filter ./docs dev --open",
    "docs-build": "pnpm --filter ./docs build",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@lazarv/create-react-server": "link:packages/create-react-server",
    "@lazarv/react-server": "link:packages/react-server"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^20.19.0",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "pkg-pr-new": "^0.0.75",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.6.3",
    "typescript-plugin-css-modules": "^5.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --concurrent false",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,json}": [
      "oxfmt"
    ],
    "*.{js,jsx,mjs,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
