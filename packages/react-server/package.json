{
  "name": "@lazarv/react-server",
  "version": "0.0.0",
  "description": "Run React anywhere",
  "keywords": [
    "esm",
    "react",
    "server",
    "ssr"
  ],
  "bugs": {
    "url": "https://github.com/lazarv/react-server/issues"
  },
  "license": "MIT",
  "author": "lazarv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazarv/react-server.git"
  },
  "bin": "bin/cli.mjs",
  "type": "module",
  "module": "server/index.mjs",
  "types": "server/index.d.ts",
  "exports": {
    "./client": {
      "types": "./client/index.d.ts",
      "default": "./client/index.jsx"
    },
    "./config": {
      "types": "./config/index.d.ts",
      "default": "./config/index.mjs"
    },
    "./config/schema": {
      "types": "./config/schema.d.ts",
      "default": "./config/schema.mjs"
    },
    "./config/schema.json": "./config/schema.json",
    "./error-boundary": {
      "types": "./server/error-boundary.d.ts",
      "default": "./server/error-boundary.jsx"
    },
    "./http": {
      "types": "./lib/http/index.d.ts",
      "default": "./lib/http/index.mjs"
    },
    "./function": {
      "types": "./server/function.d.ts",
      "default": "./server/function.mjs"
    },
    "./live": {
      "types": "./server/live.d.ts",
      "default": "./server/live.jsx"
    },
    "./lib/live/transports/client-registry.mjs": "./lib/live/transports/client-registry.mjs",
    "./mcp": {
      "types": "./server/mcp.d.ts",
      "default": "./server/mcp.mjs"
    },
    "./memory-cache/client": {
      "types": "./cache/client.d.ts",
      "default": "./cache/client.mjs"
    },
    "./memory-cache": {
      "types": "./cache/index.d.ts",
      "default": "./cache/index.mjs"
    },
    "./storage-cache": {
      "types": "./cache/storage-cache.d.ts",
      "default": "./cache/storage-cache.mjs"
    },
    "./storage-cache/crypto": {
      "default": "./cache/crypto.mjs"
    },
    "./rsc": {
      "types": "./cache/rsc.d.ts",
      "default": "./cache/rsc.mjs"
    },
    "./rsc/browser": {
      "types": "./cache/rsc.d.ts",
      "default": "./cache/rsc-browser.mjs"
    },
    "./navigation": {
      "types": "./client/navigation.d.ts",
      "default": "./client/navigation.jsx"
    },
    "./http-context": {
      "default": "./server/http-context.mjs"
    },
