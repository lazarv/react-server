    "./remote": {
      "types": "./server/remote.d.ts",
      "default": "./server/remote.jsx"
    },
    "./prerender": {
      "types": "./server/prerender.d.ts",
      "default": "./server/prerender.jsx"
    },
    "./dev": {
      "types": "./lib/dev/index.d.ts",
      "default": "./lib/dev/index.mjs"
    },
    "./devtools": {
      "types": "./devtools/index.d.ts",
      "default": "./devtools/index.jsx"
    },
    "./node": {
      "types": "./lib/start/node.d.ts",
      "default": "./lib/start/node.mjs"
    },
    "./edge": {
      "default": "./lib/start/edge.mjs"
    },
    "./build": {
      "types": "./lib/build/index.d.ts",
      "default": "./lib/build/index.mjs"
    },
    "./file-router": {
      "default": "./lib/plugins/file-router/entrypoint.jsx"
    },
    "./adapters/core": {
      "types": "./adapters/core.d.ts",
      "default": "./adapters/core.mjs"
    },
    "./adapters/bun": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/bun/index.mjs"
    },
    "./adapters/deno": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/deno/index.mjs"
    },
    "./adapters/cloudflare": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/cloudflare/index.mjs"
    },
    "./adapters/netlify": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/netlify/index.mjs"
    },
    "./adapters/vercel": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/vercel/index.mjs"
    },
    "./adapters/aws": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/aws/index.mjs"
    },
    "./adapters/azure": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/azure/index.mjs"
    },
    "./adapters/azure-swa": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/azure-swa/index.mjs"
    },
    "./adapters/firebase": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/firebase/index.mjs"
    },
    "./adapters/docker": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/docker/index.mjs"
    },
    "./adapters/singlefile": {
      "types": "./adapters/adapter.d.ts",
      "default": "./adapters/singlefile/index.mjs"
    },
    "./worker": {
      "types": "./worker/index.d.ts",
      "default": "./worker/index.mjs"
    },
    "./telemetry": {
      "types": "./telemetry/index.d.ts",
      "default": "./telemetry/index.mjs"
    },
    "./cache/*": "./cache/*",
    "./client/*": "./client/*",
    "./server/*": "./server/*",
    "./lib/*": "./lib/*",
    "./dist/*": "./dist/*.mjs",
    "./*": "./*",
    ".": {
      "types": "./server/index.d.ts",
      "default": "./server/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "scripts": {},
